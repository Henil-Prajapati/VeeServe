{
  "name": "veeserve-mern",
  "version": "1.0.0",
  "description": "VeeServe - Service Booking Platform (MERN Stack)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "heroku-postbuild": "npm run install-client && npm run build"
  },
  "keywords": ["mern", "service-booking", "react", "nodejs", "mongodb"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^6.10.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "express-validator": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "moment": "^2.29.4",
    "twilio": "^4.11.2",
    "crypto": "^1.0.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "concurrently": "^7.6.0"
  }
}
